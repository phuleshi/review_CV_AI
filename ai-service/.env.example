# ===== App =====
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ===== Security (Backend -> AI Service) =====
# Shared secret the NestJS backend sends on every request.
INTERNAL_API_KEY=change-me

# ===== LLM =====
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-xxxx
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

