# ===== App =====
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ===== Security (Backend -> AI Service) =====
# Shared secret the NestJS backend sends on every request.
INTERNAL_API_KEY=change-me

# ===== LLM =====
# heuristic = Sprint 1 default (grounded local stand-in, no API key needed)
# mock      = bare stub (exercises the engine fallback path)
# openai    = real model (set OPENAI_API_KEY)
LLM_PROVIDER=heuristic
OPENAI_API_KEY=sk-xxxx
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

# ===== Future RAG (unused in Sprint 1) =====
# PINECONE_API_KEY=
# PINECONE_INDEX=cv-knowledge-base
# EMBEDDING_MODEL=text-embedding-3-small
